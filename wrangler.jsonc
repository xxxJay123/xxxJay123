{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Static-assets-only Worker serving the Vite build at prof.xxxjay123.xyz.
	"name": "jay-cheng-site",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
	"routes": [
		{ "pattern": "prof.xxxjay123.xyz", "custom_domain": true }
	],
	"workers_dev": false,
	"preview_urls": false
}
